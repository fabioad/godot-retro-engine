@tool
extends RefCounted
## Canonical, validated settings for ROM projects generated by the engine.
##
## These values are the ones exercised by scripts/test_game_build.sh against
## PVSnesLib 4.6 and SGDK 2.11. Keeping them here (instead of duplicating magic
## numbers in the generators) prevents ROM regressions such as planar Mega Drive
## tiles, torn palette fades or unpadded SNES background maps.

const VERSION := 1
const PROFILE_FILE := "export_profile.json"

const SNES := {
	"profile_id": "snes-v1",
	"profile_version": VERSION,
	"platform": "snes",
	"display": "256x224",
	"tile_size": 8,
	"bpp": 4,
	"palette_colors": 16,
	"max_tiles": 1024,
	"bg_mode": "mode1",
	"bg_layer": "BG1",
	"tile_encoding": "snes-planar",
	"map_layout": "screens-32x32",
	"map_upload": "dma",
	"blank_tile_index": 0,
	"screen_disabled_while_loading": true,
	"screen_register": "REG_TM=0x01",
	"splash_canvas": 192,
	"splash_composite": "black",
	"splash_palette": "median-cut",
	"splash_fade": "hardware-brightness",
	"splash_fade_frames_per_level": 2,
	"splash_hold_frames": 120,
	"splash_scroll": {"x": "negative", "y": "negative"},
	"splash_backdrop": "black"
}

const MEGADRIVE := {
	"profile_id": "megadrive-v1",
	"profile_version": VERSION,
	"platform": "megadrive",
	"display": "320x224",
	"tile_size": 8,
	"bpp": 4,
	"palette_colors": 16,
	"max_tiles": 2048,
	"bg_mode": "h40",
	"bg_layer": "BG_A",
	"tile_encoding": "packed-nibbles",
	"map_layout": "linear",
	"map_upload": "dma",
	"blank_tile_index": 0,
	"clear_plane": "BG_A",
	"clear_sprites": true,
	"splash_canvas": 192,
	"splash_composite": "black",
	"splash_palette": "median-cut",
	"splash_fade": "palette-15-steps",
	"splash_fade_steps": 15,
	"splash_fade_frames_per_level": 1,
	"splash_hold_frames": 120,
	"splash_scroll": {"x": "positive", "y": "negative"},
	"splash_palette_bits": {"r": [1, 7], "g": [5, 7], "b": [9, 7]}
}

static func for_target(target: String) -> Dictionary:
	if target == "snes":
		return SNES.duplicate(true)
	if target == "megadrive":
		return MEGADRIVE.duplicate(true)
	return {}

static func all() -> Dictionary:
	return {"version": VERSION, "snes": SNES.duplicate(true), "megadrive": MEGADRIVE.duplicate(true)}

static func profile_path(dir: String) -> String:
	return dir.path_join(PROFILE_FILE)

static func write_profile(dir: String, target: String, settings: Dictionary = {}) -> Dictionary:
	var profile := for_target(target)
	if profile.is_empty():
		return {}
	profile["generated_by"] = "godot-retro-engine"
	profile["generated_at"] = Time.get_datetime_string_from_system()
	for key in settings:
		profile[key] = settings[key]
	DirAccess.make_dir_recursive_absolute(dir)
	var path := profile_path(dir)
	var file := FileAccess.open(path, FileAccess.WRITE)
	if file == null:
		return {"ok": false, "path": path, "error": "could not write export profile"}
	file.store_string(JSON.stringify(profile, "\t"))
	file.close()
	profile["ok"] = true
	profile["path"] = path
	return profile

static func apply_to_project(project: RetroProject, target: String, profile: Dictionary = {}) -> void:
	if project == null:
		return
	var applied := profile if not profile.is_empty() else for_target(target)
	if applied.is_empty():
		return
	var meta := project.get_metadata()
	meta["export_profile"] = applied
	meta["export_profile_version"] = int(applied.get("profile_version", VERSION))
	meta["export_profile_path"] = PROFILE_FILE
	project.set_metadata(meta)
